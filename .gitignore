# Build output
/bin/
/tmp/
*.exe
*.test
*.out

# Captures (pcap/jsonl can contain lab traffic; keep the directory via captures/.gitignore)
captures/*
!captures/.gitignore

# Talk deck local tooling
docs/talk/node_modules/
docs/talk/shots/
docs/talk/__pycache__/
docs/talk/*.pyc
*.pyc
__pycache__/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*~

# Env and secrets
.env
.env.*
*.pem
*.key
*.p12
credentials.json
